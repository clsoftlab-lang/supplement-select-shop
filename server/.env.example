#
# server/.env.example — 운영자용 환경변수 예시. 실제 값을 넣은 .env 는
# 절대 커밋하지 마세요( .gitignore 에 .env 포함됨 ). 키는 서버에만 둡니다.
#
# 이 파일을 .env 로 복사한 뒤 실제 키를 채웁니다:
#   cp .env.example .env

# Anthropic API 키 (서버 전용, 절대 브라우저/리포지토리에 노출 금지)
# 콘솔에서 발급한 실제 키 값을 여기에 넣습니다. (예: 접두사가 있는 비밀 키 문자열)
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_SERVER_SIDE_KEY

# 모델 (선택, 기본 비용 우선 claude-haiku-4-5)
# 품질을 더 원하면 claude-sonnet-5 또는 claude-opus-5 로 상향
AI_MODEL=claude-haiku-4-5

# effort (선택, 기본 low) — Haiku 외 모델에서만 output_config.effort 로 전송
AI_EFFORT=low

# 월 토큰 예산 (선택, 기본 2000000) — 초과 시 429 {fallback:true}
AI_MONTHLY_TOKEN_CAP=2000000

# IP 당 분당 요청 제한 (선택, 기본 20)
AI_RATE_PER_MIN=20

# 프록시 포트 (선택, 기본 8787)
PORT=8787

# CORS 허용 출처 (선택, 기본 "*" — 운영 시 정적 사이트 출처로 제한 권장)
# 예: ALLOWED_ORIGIN=https://clsoftlab-lang.github.io
ALLOWED_ORIGIN=*
